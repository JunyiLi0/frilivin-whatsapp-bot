# =============================================================================
#  frilivin-whatsapp-bot — configuration
#  Copier ce fichier vers .env puis adapter :  cp .env.example .env
#  Le fichier .env n'est JAMAIS versionné (voir .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
#  Secret partagé entre les services internes (en-tête X-Bot-Token).
#  OBLIGATOIRE. Générer avec :  openssl rand -hex 32
# -----------------------------------------------------------------------------
BOT_TOKEN=change-me-openssl-rand-hex-32

# -----------------------------------------------------------------------------
#  Réseau interne
# -----------------------------------------------------------------------------
# URL de l'API vue depuis le bridge (nom de service Docker)
API_URL=http://api:8000
# URL du bridge vue depuis l'api et le worker
BRIDGE_URL=http://bridge:3000

# Ports publiés sur l'hôte. Ils sont bindés sur 127.0.0.1 dans docker-compose.yml :
# n'exposez JAMAIS ces ports sur l'internet public.
API_PORT=8000
BRIDGE_PORT=3000

# -----------------------------------------------------------------------------
#  Journalisation (JSON structuré sur stdout)
#  debug | info | warning | error
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
#  Bridge WhatsApp (Baileys)
# -----------------------------------------------------------------------------
# Répertoire de la session multi-device (volume Docker `wa_session`).
# Supprimer ce répertoire force un nouveau scan de QR code.
WA_SESSION_DIR=/data/session

# File d'envoi persistée sur disque : les messages en attente survivent
# à un redémarrage du conteneur.
OUTBOX_PATH=/data/outbox.json

# Délai aléatoire appliqué avant CHAQUE envoi, en millisecondes.
# Sert à imiter un rythme humain ; ne pas descendre trop bas.
SEND_DELAY_MIN_MS=2000
SEND_DELAY_MAX_MS=8000

# Nombre de messages entrants dont on garde la clé WhatsApp en mémoire,
# afin de pouvoir répondre en citant un message (quoted_id).
QUOTED_CACHE_SIZE=2000

# Durée de déconnexion WhatsApp au-delà de laquelle le bridge se termine, pour
# que Docker recrée le conteneur. Le watchdog relance déjà la connexion toutes
# les 45 s ; ceci n'est que le filet de sécurité si le process est réellement
# coincé. 0 désactive la sortie et ne garde que les relances internes.
BRIDGE_DISCONNECT_EXIT_MS=900000

# true = aucun message n'est réellement envoyé, tout est seulement journalisé.
# Idéal pour tester le pipeline sans risquer le compte WhatsApp.
BRIDGE_DRY_RUN=false

# Nom affiché dans WhatsApp > Appareils liés.
WA_BROWSER_NAME=frilivin-bot

# -----------------------------------------------------------------------------
#  Pièces jointes
# -----------------------------------------------------------------------------
# Répertoire où le bridge dépose les fichiers reçus (volume `media_data`).
MEDIA_INBOX_DIR=/media/in
# Répertoire où le worker écrit les fichiers à renvoyer.
MEDIA_OUTBOX_DIR=/media/out

# Extensions téléchargées. Vide = tous les documents, ce qui expose le disque
# au premier plaisantin qui envoie une vidéo.
MEDIA_ALLOWED_EXTENSIONS=.xlsx,.xlsm

# Taille maximale d'une pièce jointe, en octets (10 Mo par défaut).
MEDIA_MAX_BYTES=10485760

# -----------------------------------------------------------------------------
#  Base de données et file d'attente
# -----------------------------------------------------------------------------
DATABASE_PATH=/data/bot.db
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=inbound
DLQ_NAME=dead

# -----------------------------------------------------------------------------
#  Worker
# -----------------------------------------------------------------------------
# Budget de traitement par message, en secondes (contrainte : < 2 s).
WORKER_JOB_TIMEOUT=2
# Budget pour un message porteur d'un fichier : lire un classeur et les exports
# Sage ne tient pas en 2 s. Appliqué automatiquement à ces seuls messages.
WORKER_DOCUMENT_JOB_TIMEOUT=60
# Nombre de tentatives supplémentaires après un échec.
WORKER_MAX_RETRIES=3
# Backoff exponentiel entre les tentatives, en secondes, séparé par des virgules.
WORKER_RETRY_INTERVALS=2,8,32

# -----------------------------------------------------------------------------
#  Limiteur de débit global (tous handlers confondus)
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_DAY=500
RATE_LIMIT_PER_MINUTE=30

# -----------------------------------------------------------------------------
#  Handlers d'exemple
# -----------------------------------------------------------------------------
# PingHandler : répond « pong » à « !ping ».
PING_ENABLED=true

# GroupRelayHandler : relaie vers un ou plusieurs groupes tout message privé
# contenant l'un de ces mots-clés (séparés par des virgules, insensible à la casse).
# Laisser RELAY_TARGET_JIDS vide désactive le handler.
# Récupérer les JID des groupes avec :  curl -H "X-Bot-Token: $BOT_TOKEN" localhost:8000/groups
RELAY_KEYWORDS=urgent,alerte
RELAY_TARGET_JIDS=

# -----------------------------------------------------------------------------
#  SageImportHandler — un .xlsx entrant, un import_sage_<nnn>.txt en retour
#
#  Envoyez le fichier de commande au bot : il répond avec le fichier d'import
#  Sage 50, nommé d'après les 3 derniers chiffres du numéro de commande
#  (commande 1104999 -> import_sage_999.txt). En cas d'échec, il répond la
#  raison. Tous les .xlsx sont traités, sans commande à retenir.
# -----------------------------------------------------------------------------
SAGE_ENABLED=true

# Exports Sage de référence, déposés dans ./sage-data/ (monté en lecture seule).
# Voir sage-data/.gitkeep pour la procédure de copie.
SAGE_CLIENTS_PATH=/data/sage/clients.txt
SAGE_ARTICLES_PATH=/data/sage/articles.txt

# Qui peut soumettre un classeur. VIDE = tout le monde, ce qui convient si le
# numéro n'est connu que de l'équipe. Même format que BROADCAST_ADMIN_JIDS.
SAGE_ADMIN_JIDS=

# Confiance exigée pour rattacher une facture à un client Sage (0 à 1).
# Monter cette valeur laisse plus de factures sans code client ; la baisser
# risque un rattachement au mauvais compte, bien plus difficile à repérer.
# La légende renvoyée affiche le client retenu et son score : vérifiez-la.
SAGE_CLIENT_MATCH_THRESHOLD=0.60

# -----------------------------------------------------------------------------
#  BroadcastHandler — diffusion « un destinataire par ligne »
#
#      !envoi
#      33766793050; Bonjour, la réunion est déplacée
#      120363000000000000@g.us; Compte rendu envoyé
#      nord; Message pour l'alias « nord »
# -----------------------------------------------------------------------------
BROADCAST_ENABLED=true

# Commande qui déclenche une diffusion.
BROADCAST_COMMAND=!envoi

# ⚠️ OBLIGATOIRE pour activer le handler. Qui a le droit de diffuser, séparé par
# des virgules. Numéro nu ou JID complet, au choix :
#   BROADCAST_ADMIN_JIDS=33612345678,33698765432@s.whatsapp.net
# Laisser vide = personne, donc handler désactivé. Sans cette liste, n'importe
# qui écrivant au numéro disposerait d'un relais de diffusion.
BROADCAST_ADMIN_JIDS=

# Nombre maximum de destinataires par diffusion. Au-delà, le lot entier est
# refusé (plutôt que d'envoyer le début et de perdre la fin).
# Automatiquement borné à RATE_LIMIT_PER_MINUTE - 1 : chaque destinataire
# consomme un jeton de quota, et l'accusé de réception en consomme un de plus.
BROADCAST_MAX_RECIPIENTS=25

# Alias pratiques, pour ne pas recopier un JID de 18 chiffres à la main.
# Format : nom=cible, séparés par des virgules.
#   BROADCAST_ALIASES=nord=120363000000000000@g.us,sud=33612345678
# Des alias peuvent aussi être ajoutés à chaud dans la table `state`,
# sous la clé  broadcast:alias:<nom>  (ils sont prioritaires sur ceux-ci).
BROADCAST_ALIASES=
