# =============================================================================
#  frilivin-whatsapp-bot — configuration
#  Copier ce fichier vers .env puis adapter :  cp .env.example .env
#  Le fichier .env n'est JAMAIS versionné (voir .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
#  Secret partagé entre les services internes (en-tête X-Bot-Token).
#  OBLIGATOIRE. Générer avec :  openssl rand -hex 32
# -----------------------------------------------------------------------------
BOT_TOKEN=change-me-openssl-rand-hex-32

# -----------------------------------------------------------------------------
#  Réseau interne
# -----------------------------------------------------------------------------
# URL de l'API vue depuis le bridge (nom de service Docker)
API_URL=http://api:8000
# URL du bridge vue depuis l'api et le worker
BRIDGE_URL=http://bridge:3000

# Ports publiés sur l'hôte. Ils sont bindés sur 127.0.0.1 dans docker-compose.yml :
# n'exposez JAMAIS ces ports sur l'internet public.
API_PORT=8000
BRIDGE_PORT=3000

# -----------------------------------------------------------------------------
#  Journalisation (JSON structuré sur stdout)
#  debug | info | warning | error
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
#  Bridge WhatsApp (Baileys)
# -----------------------------------------------------------------------------
# Répertoire de la session multi-device (volume Docker `wa_session`).
# Supprimer ce répertoire force un nouveau scan de QR code.
WA_SESSION_DIR=/data/session

# File d'envoi persistée sur disque : les messages en attente survivent
# à un redémarrage du conteneur.
OUTBOX_PATH=/data/outbox.json

# Délai aléatoire appliqué avant CHAQUE envoi, en millisecondes.
# Sert à imiter un rythme humain ; ne pas descendre trop bas.
SEND_DELAY_MIN_MS=2000
SEND_DELAY_MAX_MS=8000

# Nombre de messages entrants dont on garde la clé WhatsApp en mémoire,
# afin de pouvoir répondre en citant un message (quoted_id).
QUOTED_CACHE_SIZE=2000

# true = aucun message n'est réellement envoyé, tout est seulement journalisé.
# Idéal pour tester le pipeline sans risquer le compte WhatsApp.
BRIDGE_DRY_RUN=false

# Nom affiché dans WhatsApp > Appareils liés.
WA_BROWSER_NAME=frilivin-bot

# -----------------------------------------------------------------------------
#  Base de données et file d'attente
# -----------------------------------------------------------------------------
DATABASE_PATH=/data/bot.db
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=inbound
DLQ_NAME=dead

# -----------------------------------------------------------------------------
#  Worker
# -----------------------------------------------------------------------------
# Budget de traitement par message, en secondes (contrainte : < 2 s).
WORKER_JOB_TIMEOUT=2
# Nombre de tentatives supplémentaires après un échec.
WORKER_MAX_RETRIES=3
# Backoff exponentiel entre les tentatives, en secondes, séparé par des virgules.
WORKER_RETRY_INTERVALS=2,8,32

# -----------------------------------------------------------------------------
#  Limiteur de débit global (tous handlers confondus)
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_DAY=500
RATE_LIMIT_PER_MINUTE=30

# -----------------------------------------------------------------------------
#  Handlers d'exemple
# -----------------------------------------------------------------------------
# PingHandler : répond « pong » à « !ping ».
PING_ENABLED=true

# GroupRelayHandler : relaie vers un ou plusieurs groupes tout message privé
# contenant l'un de ces mots-clés (séparés par des virgules, insensible à la casse).
# Laisser RELAY_TARGET_JIDS vide désactive le handler.
# Récupérer les JID des groupes avec :  curl -H "X-Bot-Token: $BOT_TOKEN" localhost:8000/groups
RELAY_KEYWORDS=urgent,alerte
RELAY_TARGET_JIDS=
